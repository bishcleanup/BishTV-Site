{
  "name": "bishcleanup-resume",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.vcf", "**/*.txt"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.pdf", "**/*.png"], "fallthrough": true }
  ],
  "routes": [{ "pattern": "resume.bishcleanup.com", "custom_domain": true }],
  "workers_dev": false
}
